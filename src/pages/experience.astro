---
import SpeakingCard from "../components/cards/SpeakingCard.astro";
import WorkExperienceCard from "../components/cards/WorkExperienceCard.astro";
import BackLink from "../components/common/BackLink.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { achievements, projects, speaking, workExperience } from "../data";
import StaticLayout from "../layouts/StaticLayout.astro";
import { byDateDesc, isCve } from "../utils";

const cveCount = achievements.filter(isCve).length;
const acknowledgementCount = achievements.length - cveCount;
const sortedSpeaking = [...speaking].sort(byDateDesc);

const facts = [
  { value: projects.length, label: "Open source projects" },
  { value: cveCount, label: "CVEs" },
  { value: acknowledgementCount, label: "Acknowledgements and awards" },
  {
    value: speaking.filter((s) => s.role === "speaker").length,
    label: "Speaking engagements",
  },
];
---

<StaticLayout
  title="Experience"
  description="Aviv Keller's open source roles, contract work, and conference speaking."
>
  <BackLink href="/" label="Home" />

  <SectionHeader
    as="h1"
    title="Experience"
    subtitle="Open source roles, contract work, and conferences"
  />

  <dl class="mb-14 grid grid-cols-2 border-t-4 border-brand md:grid-cols-4">
    {facts.map((fact) => (
      <div class="border-b border-stone-200 py-5 pr-4">
        <dd class="font-display text-4xl font-bold text-brand tabular-nums">
          {fact.value}
        </dd>
        <dt class="mt-1 text-sm text-stone-600">{fact.label}</dt>
      </div>
    ))}
  </dl>

  <section id="work" class="mb-14">
    <SectionHeader title="Roles" />
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
      {workExperience.map((experience) => (
        <WorkExperienceCard experience={experience} />
      ))}
    </div>
  </section>

  <section id="speaking" class="scroll-mt-20">
    <SectionHeader title="Speaking and conferences" />
    <ol>
      {sortedSpeaking.map((engagement) => (
        <SpeakingCard engagement={engagement} />
      ))}
    </ol>
  </section>
</StaticLayout>
