---
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import StaticLayout from "../layouts/StaticLayout.astro";
---

<StaticLayout title="Page not found">
  <div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <p class="text-6xl font-bold text-brand">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-stone-900">
      Page not found
    </h1>
    <p class="mt-3 max-w-md text-stone-600">
      There's nothing at this address. It may have moved, or the link may be
      wrong.
    </p>
    <Button href="/" class="mt-8">
      <Icon name="mdi:arrow-left" size={16} />
      Back to home
    </Button>
  </div>
</StaticLayout>
