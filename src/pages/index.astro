---
import AchievementCard from "../components/cards/AchievementCard.astro";
import BlogCard from "../components/cards/BlogCard.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import SpeakingCard from "../components/cards/SpeakingCard.astro";
import WorkExperienceCard from "../components/cards/WorkExperienceCard.astro";
import Hero from "../components/sections/Hero.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import {
  projects,
  achievements,
  workExperience,
  speaking,
  socialLinks,
  siteConfig,
} from "../data";
import MainLayout from "../layouts/MainLayout.astro";
import { byDateDesc, getAllPosts } from "../utils";

const featuredProjects = projects.slice(0, 3);
const featuredAchievements = achievements.slice(0, 6);
const recentBlogs = getAllPosts().slice(0, 3);
const featuredExperience = workExperience.slice(0, 2);
const recentSpeaking = speaking
  .filter((s) => s.role === "speaker")
  .sort(byDateDesc)
  .slice(0, 3);
---

<MainLayout>
  <Hero
    name={siteConfig.name}
    socialLinks={socialLinks}
    email={siteConfig.email}
  />

  <Section id="projects">
    <SectionHeader
      title="Projects"
      subtitle="Libraries and tools I maintain, mostly for the JavaScript ecosystem."
      href="/projects"
      linkText={`All ${projects.length} projects`}
    />
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </Section>

  <Section class="bg-brand-tint" id="experience">
    <SectionHeader
      title="Experience"
      subtitle="Where have I been?"
      href="/experience"
    />
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
      {featuredExperience.map((experience) => (
        <WorkExperienceCard experience={experience} />
      ))}
    </div>
  </Section>

  <Section id="speaking">
    <SectionHeader
      title="Speaking"
      subtitle="Conferences and summits I've spoken at."
      href="/experience#speaking"
    />
    <ol>
      {recentSpeaking.map((engagement) => (
        <SpeakingCard engagement={engagement} />
      ))}
    </ol>
  </Section>

  <Section class="bg-brand-tint" id="achievements">
    <SectionHeader
      title="Recognition"
      subtitle="Awards, security acknowledgements, and CVEs credited to me."
      href="/achievements"
      linkText={`All ${achievements.length} entries`}
    />
    <ul class="grid grid-cols-1 border-t border-stone-200 md:grid-cols-2 md:gap-x-8 lg:grid-cols-3">
      {featuredAchievements.map((achievement) => (
        <AchievementCard achievement={achievement} />
      ))}
    </ul>
  </Section>

  {recentBlogs.length > 0 && (
    <Section id="blog">
      <SectionHeader
        title="Writing"
        subtitle="Posts I've written here and elsewhere."
        href="/blog"
        linkText="All posts"
      />
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {recentBlogs.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </Section>
  )}
</MainLayout>
