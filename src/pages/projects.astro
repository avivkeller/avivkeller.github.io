---
import ProjectCard from "../components/cards/ProjectCard.astro";
import BackLink from "../components/common/BackLink.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { projects } from "../data";
import StaticLayout from "../layouts/StaticLayout.astro";
---

<StaticLayout title="Projects">
  <BackLink href="/" label="Portfolio" />
  <SectionHeader
    title="My Projects"
    subtitle="A collection of open source projects, tools, and contributions to the developer community"
  />
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</StaticLayout>
