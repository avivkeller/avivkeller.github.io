---
import ProjectCard from "../components/cards/ProjectCard.astro";
import BackLink from "../components/common/BackLink.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { projects } from "../data";
import StaticLayout from "../layouts/StaticLayout.astro";
---

<StaticLayout
  title="Projects"
  description="Open source libraries and tools by Aviv Keller."
>
  <BackLink href="/" label="Home" />
  <SectionHeader
    as="h1"
    title="Projects"
    subtitle="Open source libraries and tools I've written or maintain."
  />
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</StaticLayout>
