---
import BlogCard from "../components/cards/BlogCard.astro";
import BackLink from "../components/common/BackLink.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import StaticLayout from "../layouts/StaticLayout.astro";

const blogs = Object.values(import.meta.glob("./posts/*.md", { eager: true }));
---

<StaticLayout title="Blog">
  <BackLink href="/" label="Portfolio" />
  <SectionHeader
    title="Blog Posts"
    subtitle="Insights on technology, security, and software development"
  />
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    {blogs.map((post) => <BlogCard post={post} />)}
  </div>
</StaticLayout>
