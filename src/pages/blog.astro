---
import BlogCard from "../components/cards/BlogCard.astro";
import BackLink from "../components/common/BackLink.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import StaticLayout from "../layouts/StaticLayout.astro";
import { getAllPosts } from "../utils";

const posts = getAllPosts();
---

<StaticLayout title="Blog" description="Writing by Aviv Keller.">
  <BackLink href="/" label="Home" />
  <SectionHeader
    as="h1"
    title="Blog"
    subtitle="Posts I've written here and elsewhere. Entries marked with a source open on that site."
  />
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {posts.map((post) => (
      <BlogCard post={post} />
    ))}
  </div>
</StaticLayout>
