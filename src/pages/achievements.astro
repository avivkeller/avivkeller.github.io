---
import AchievementCard from "../components/cards/AchievementCard.astro";
import BackLink from "../components/common/BackLink.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { achievements } from "../data";
import StaticLayout from "../layouts/StaticLayout.astro";
import { isCve } from "../utils";

const cves = achievements.filter(isCve);
const acknowledgements = achievements.filter((a) => !isCve(a));
---

<StaticLayout
  title="Achievements"
  description="Awards, security hall of fame credits, and CVEs assigned to vulnerabilities Aviv Keller reported."
>
  <BackLink href="/" label="Home" />

  <SectionHeader
    as="h1"
    title="Achievements"
    subtitle="Awards and security acknowledgements from organizations I've reported vulnerabilities to, plus CVEs assigned to those reports. This is a partial list."
  />

  <section class="mb-12">
    <SectionHeader as="h2" size="h3" title="Awards and acknowledgements" />
    <ul class="grid grid-cols-1 border-t border-stone-200 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-3">
      {acknowledgements.map((achievement) => (
        <AchievementCard achievement={achievement} />
      ))}
    </ul>
  </section>

  <section>
    <SectionHeader as="h2" size="h3" title="CVEs" />
    <ul class="grid grid-cols-1 border-t border-stone-200 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-3">
      {cves.map((achievement) => (
        <AchievementCard achievement={achievement} />
      ))}
    </ul>
  </section>
</StaticLayout>
