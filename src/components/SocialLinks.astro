---
import SocialLink from "./SocialLink.astro";

const links = [
  { href: "https://github.com/avivkeller", icon: "simple-icons:github" },
  { href: "https://x.com/aviv_keller", icon: "simple-icons:x" },
  { href: "https://bsky.app/profile/aviv.sh", icon: "simple-icons:bluesky" },
  {
    href: "https://www.linkedin.com/in/avivkeller",
    icon: "simple-icons:linkedin",
  },
  { href: "https://hackerone.com/aviv_keller", icon: "simple-icons:hackerone" },
  {
    href: "https://github.com/sponsors/avivkeller",
    icon: "simple-icons:githubsponsors",
  },
  { href: "mailto:me@aviv.sh", icon: "mdi:email" },
];
---

<div class="flex space-x-4">
  {links.map((link) => <SocialLink {...link} />)}
</div>
