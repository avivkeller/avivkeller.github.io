---
import { Icon } from "astro-icon/components";
import sections from "../data/sections";

const { static: isStatic = false } = Astro.props;
---

<nav
  id="navbar"
  class={`fixed top-0 right-0 left-0 z-50 ${isStatic ? "shadow-md bg-white" : "transition-all duration-300"}`}
>
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between py-4">
      <a
        id="logo"
        class={`text-2xl font-bold ${isStatic ? "text-red-600" : "text-white"}`}
        href="/">Aviv Keller</a
      >

      <div
        id="menu-items"
        class={`hidden space-x-6 ${isStatic ? "" : "text-white"} md:flex`}
      >
        {
          sections.map(({ title, href, target = "_self" }) => (
            <a
              href={href}
              target={target}
              class={`nav-link transition-colors duration-300 ${isStatic ? "hover:text-red-600" : ""}`}
            >
              {title}
            </a>
          ))
        }
      </div>

      <button
        id="menuToggle"
        class={`z-40 ${isStatic ? "" : "text-white"} md:hidden cursor-poi`}
        aria-expanded="false"
      >
        <Icon class="h-8 w-8" name="mdi:menu" />
      </button>
    </div>
  </div>

  <div
    id="mobileMenu"
    class="fixed inset-0 z-30 flex hidden flex-col items-center justify-center space-y-6 bg-white md:hidden"
  >
    {
      sections.map(({ title, href, target = "_self" }) => (
        <a
          href={href}
          target={target}
          class="text-xl text-gray-600 transition-colors duration-300 hover:text-red-600"
        >
          {title}
        </a>
      ))
    }
  </div>
</nav>

<script define:vars={{ isStatic }} is:inline>
  const navbar = document.getElementById("navbar");
  const logo = document.getElementById("logo");
  const navLinks = document.querySelectorAll(".nav-link");
  const menuToggle = document.getElementById("menuToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  menuToggle.onclick = () => {
    menuToggle.setAttribute(
      "aria-expanded",
      mobileMenu.classList.contains("hidden") ? "false" : "true",
    );
    mobileMenu.classList.toggle("hidden");
    if (isStatic && window.scrollY <= 50) {
      menuToggle.classList.toggle("text-white");
      menuToggle.classList.toggle("text-gray-600");
    }
  };

  !isStatic &&
    window.addEventListener("scroll", () => {
      if (mobileMenu.classList.contains("hidden")) {
        const isScrolled = window.scrollY > 50;
        navbar.classList.toggle("bg-white", isScrolled);
        navbar.classList.toggle("shadow-md", isScrolled);
        logo.classList.toggle("text-red-600", isScrolled);
        logo.classList.toggle("text-white", !isScrolled);

        navLinks.forEach((link) => {
          link.classList.toggle("text-gray-600", isScrolled);
          link.classList.toggle("text-white", !isScrolled);
          link.classList.toggle("hover:text-red-600", isScrolled);
        });

        menuToggle.classList.toggle("text-gray-600", isScrolled);
        menuToggle.classList.toggle("text-white", !isScrolled);
      }
    });
</script>
{isStatic && <div class="relative h-16" />}
