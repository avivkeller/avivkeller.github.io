---
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";

const { experience } = Astro.props;

const typeConfig = {
  "full-time": { color: "success", icon: "mdi:briefcase" },
  "part-time": { color: "primary", icon: "mdi:clock-outline" },
  contract: { color: "secondary", icon: "mdi:handshake" },
  internship: { color: "warning", icon: "mdi:school" },
  volunteer: { color: "danger", icon: "mdi:heart" },
};

const config = typeConfig[experience.type];
---

<Card class="p-8">
  <div class="mb-6 flex items-start justify-between">
    <div class="flex-1">
      <div class="mb-2 flex items-center gap-3">
        <h3 class="text-2xl font-bold text-gray-900">{experience.company}</h3>
        {
          experience.website && (
            <a
              href={experience.website}
              target="_blank"
              aria-label={experience.company}
              rel="noopener noreferrer"
              class="text-red-600 transition-colors hover:text-red-700"
            >
              <Icon name="mdi:external-link" size={20} />
            </a>
          )
        }
      </div>
      <h4 class="mb-2 text-xl font-semibold text-red-600">
        {experience.position}
      </h4>
      <div class="mb-4 flex flex-wrap items-center gap-4 text-sm text-gray-600">
        <div class="flex items-center gap-1">
          <Icon name="mdi:calendar" size={16} />
          <span>{experience.duration}</span>
        </div>
        <div class="flex items-center gap-1">
          <Icon name="mdi:map-marker" size={16} />
          <span>{experience.location}</span>
        </div>
      </div>
    </div>
    <Badge variant={config.color} class="flex items-center gap-1">
      <Icon name={config.icon} size={14} />
      {experience.type.charAt(0).toUpperCase() + experience.type.slice(1)}
    </Badge>
  </div>

  <div class="mb-6">
    <ul class="space-y-2">
      {
        experience.description.map((item) => (
          <li class="flex items-start gap-2 text-gray-700">
            <Icon
              name="mdi:chevron-right"
              size={16}
              class="mt-0.5 flex-shrink-0 text-red-500"
            />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {
    experience.technologies && (
      <div>
        <h5 class="mb-3 text-sm font-semibold text-gray-900">
          Technologies & Skills
        </h5>
        <div class="flex flex-wrap gap-2">
          {experience.technologies.map((tech) => (
            <Badge variant="secondary">{tech}</Badge>
          ))}
        </div>
      </div>
    )
  }
</Card>
