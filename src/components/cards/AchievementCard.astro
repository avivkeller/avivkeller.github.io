---
import type { Achievement } from "../../types";
import Icon from "../ui/Icon.astro";

const { achievement } = Astro.props as { achievement: Achievement };
---

<li class="border-b border-stone-200">
  <a
    href={achievement.url}
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center gap-3 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
  >
    <span class="flex h-8 w-8 shrink-0 items-center justify-center text-brand transition-colors group-hover:text-brand-deep">
      <Icon name={achievement.icon || "mdi:shield-check-outline"} size={20} />
    </span>
    <span class="text-sm font-medium text-stone-900 underline decoration-transparent decoration-2 underline-offset-4 transition-colors group-hover:decoration-brand">
      {achievement.title}
    </span>
  </a>
</li>
