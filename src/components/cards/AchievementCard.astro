---
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";

const { achievement } = Astro.props;
---

<Card href={achievement.url} target="_blank" class="p-8 text-center">
  <div class="mb-6 flex justify-center">
    <Icon
      name={achievement.icon || "mdi:security"}
      size={48}
      class="text-red-600 transition-colors group-hover:text-red-700"
    />
  </div>
  <h3
    class="text-xl font-bold text-gray-900 transition-colors group-hover:text-red-600"
  >
    {achievement.title}
  </h3>
</Card>
