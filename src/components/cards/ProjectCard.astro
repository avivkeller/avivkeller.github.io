---
import type { Project } from "../../types";
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";

const { project } = Astro.props as { project: Project };

const stars = (project.stars ?? 0) >= 10 ? project.stars : undefined;
const downloads =
  (project.downloads ?? 0) >= 100 ? project.downloads : undefined;

const compact = new Intl.NumberFormat("en", { notation: "compact" });

const links = [
  { href: project.githubLink, icon: "mdi:github", label: "Source", size: 18 },
  { href: project.npmLink, icon: "simple-icons:npm", label: "npm", size: 16 },
  {
    href: project.website,
    icon: "mdi:open-in-new",
    label: "Website",
    size: 16,
  },
].filter((link) => link.href);
---

<Card class="relative flex h-full flex-col overflow-hidden">
  {project.isNew && (
    <span class="pointer-events-none absolute top-3 -right-8 w-28 rotate-45 bg-brand py-0.5 text-center text-[10px] font-bold tracking-wider text-white uppercase shadow-sm">
      New
    </span>
  )}
  <div class="flex flex-1 flex-col p-5">
    <div
      class={`flex flex-wrap items-center gap-2 ${project.isNew ? "pr-10" : ""}`}
    >
      <h3 class="text-lg font-bold text-stone-900">{project.title}</h3>
      {project.role && <Badge variant="neutral">{project.role}</Badge>}
    </div>
    <p class="mt-1.5 flex-1 text-sm leading-relaxed text-stone-600">
      {project.description}
    </p>

    {project.technologies && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {project.technologies.map((tech) => (
          <li>
            <Badge>{tech}</Badge>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-stone-100 pt-4 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-semibold text-stone-700 hover:text-brand"
        >
          <Icon name={link.icon} size={link.size} />
          {link.label}
        </a>
      ))}
      {(!!stars || !!downloads) && (
        <div class="ml-auto flex items-center gap-3 text-xs text-stone-500 tabular-nums">
          {!!stars && (
            <span
              class="inline-flex items-center gap-1"
              title={`${stars.toLocaleString("en")} GitHub stars`}
            >
              <Icon name="mdi:star-outline" size={14} />
              {compact.format(stars)}
            </span>
          )}
          {!!downloads && (
            <span
              class="inline-flex items-center gap-1"
              title={`${downloads.toLocaleString("en")} npm downloads last month`}
            >
              <Icon name="mdi:download" size={14} />
              {compact.format(downloads)}/mo
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</Card>
