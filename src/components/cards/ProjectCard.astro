---
import { Image } from "astro:assets";

import type { Project } from "../../types";
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";

const { project } = Astro.props as { project: Project };
---

<Card class="flex h-full flex-col overflow-hidden">
  {project.image && (
    <Image
      src={project.image}
      alt=""
      class="h-40 w-full border-b border-stone-200 object-cover"
    />
  )}

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-lg font-bold text-stone-900">{project.title}</h3>
      {project.role && <Badge variant="neutral">{project.role}</Badge>}
    </div>
    <p class="mt-1.5 flex-1 text-sm leading-relaxed text-stone-600">
      {project.description}
    </p>

    {project.technologies && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {project.technologies.map((tech) => (
          <li>
            <Badge>{tech}</Badge>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-5 flex items-center gap-4 border-t border-stone-100 pt-4 text-sm">
      <a
        href={project.githubLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-semibold text-stone-700 hover:text-brand"
      >
        <Icon name="mdi:github" size={18} />
        Source
      </a>
      {project.website && (
        <a
          href={project.website}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-semibold text-stone-700 hover:text-brand"
        >
          <Icon name="mdi:open-in-new" size={16} />
          Website
        </a>
      )}
    </div>
  </div>
</Card>
