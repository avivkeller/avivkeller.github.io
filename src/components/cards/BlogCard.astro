---
import type { BlogPost } from "../../types";
import { formatDate } from "../../utils";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";

const { post } = Astro.props as { post: BlogPost };
const external = Boolean(post.source);
---

<Card
  href={post.url}
  target={external ? "_blank" : "_self"}
  class="flex h-full flex-col p-5"
>
  <p class="flex flex-wrap items-center gap-x-2 text-xs text-stone-500">
    <time datetime={post.date}>{formatDate(post.date)}</time>
    {post.readingTime && (
      <>
        <span aria-hidden="true">·</span>
        <span>{post.readingTime}</span>
      </>
    )}
    {post.source && (
      <>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1 font-medium text-brand">
          {post.source}
          <Icon name="mdi:open-in-new" size={12} />
        </span>
      </>
    )}
  </p>
  <h3 class="mt-2 text-lg font-bold text-stone-900 transition-colors group-hover:text-brand">
    {post.title}
  </h3>
  <p class="mt-1.5 text-sm leading-relaxed text-stone-600">
    {post.description}
  </p>
</Card>
