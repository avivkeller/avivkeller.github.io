---
import SocialLinks from "../common/SocialLinks.astro";

const { siteName, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-stone-200">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6">
    <p class="text-sm text-stone-600">
      © {currentYear} {siteName}
    </p>
    <SocialLinks links={socialLinks} size={20} />
  </div>
</footer>
