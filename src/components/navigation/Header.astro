---
import Icon from "../ui/Icon.astro";

const { navigation, siteName } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrent = (href: string) =>
  href.startsWith("/") && currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-stone-200 bg-white/95 backdrop-blur">
  <nav
    class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6"
    aria-label="Main"
  >
    <a
      href="/"
      class="font-display text-xl font-bold tracking-tight text-brand"
    >
      {siteName}
    </a>

    <ul class="hidden items-center gap-6 md:flex">
      {navigation.map(({ title, href, target = "_self" }) => (
        <li>
          <a
            href={href}
            target={target}
            rel={target === "_blank" ? "noopener noreferrer" : undefined}
            aria-current={isCurrent(href) ? "page" : undefined}
            class={`text-sm transition-colors hover:text-brand ${isCurrent(href) ? "font-semibold text-brand" : "text-stone-700"}`}
          >
            {title}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="menuToggle"
      type="button"
      class="-mr-2 inline-flex h-10 w-10 items-center justify-center rounded-md text-stone-700 hover:bg-brand-tint hover:text-brand md:hidden"
      aria-expanded="false"
      aria-controls="mobileMenu"
      aria-label="Open menu"
    >
      <Icon name="mdi:menu" size={24} data-icon-open />
      <Icon name="mdi:close" size={24} class="hidden" data-icon-close />
    </button>
  </nav>

  <div id="mobileMenu" class="hidden border-t border-stone-200 md:hidden">
    <ul class="mx-auto max-w-6xl px-4 py-2 sm:px-6">
      {navigation.map(({ title, href, target = "_self" }) => (
        <li>
          <a
            href={href}
            target={target}
            rel={target === "_blank" ? "noopener noreferrer" : undefined}
            aria-current={isCurrent(href) ? "page" : undefined}
            class={`block rounded-md px-2 py-2.5 text-base hover:bg-brand-tint hover:text-brand ${isCurrent(href) ? "font-semibold text-brand" : "text-stone-700"}`}
          >
            {title}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menuToggle");
  const menu = document.getElementById("mobileMenu");
  const openIcon = toggle?.querySelector("[data-icon-open]");
  const closeIcon = toggle?.querySelector("[data-icon-close]");

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  });
</script>
