---
import Icon from "./Icon.astro";

const { icon, value, label } = Astro.props;
---

<div
  class="rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-all duration-300 hover:shadow-lg"
>
  <div
    class={`inline-flex items-center justify-center w-12 h-12 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-full mb-4`}
  >
    <Icon name={icon} size={24} />
  </div>
  <div class="text-2xl font-bold text-gray-900">{value}</div>
  <div class="text-sm text-gray-600">{label}</div>
</div>
