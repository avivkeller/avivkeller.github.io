---
const { href, target = "_self", class: className = "", ...props } = Astro.props;

const baseClasses =
  "group block rounded-sm border border-stone-200 bg-white transition-colors";
const interactive = href
  ? "hover:border-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
  : "";
const classes = `${baseClasses} ${interactive} ${className}`;

const Component = href ? "a" : "div";
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<Component class={classes} {...(href ? { href, target, rel } : {})} {...props}>
  <slot />
</Component>
