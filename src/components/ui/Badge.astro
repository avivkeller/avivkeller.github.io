---
const { variant = "primary", class: className = "" } = Astro.props;

const variants = {
  primary: "bg-brand-tint text-brand-deep",
  neutral: "bg-stone-100 text-stone-700",
};

const classes = `inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs font-medium ${variants[variant]} ${className}`;
---

<span class={classes}>
  <slot />
</span>
