---
const { title, subtitle, class: className = "" } = Astro.props;
---

<div class={`text-center mb-16 ${className}`}>
  <h2 class={`text-4xl font-black md:text-5xl text-red-700 mb-4`}>
    {title}
  </h2>
  {
    subtitle && (
      <p class="mx-auto max-w-2xl text-xl text-gray-600">{subtitle}</p>
    )
  }
</div>
