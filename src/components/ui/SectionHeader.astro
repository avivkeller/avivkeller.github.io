---
const {
  title,
  subtitle,
  as: Tag = "h2",
  href,
  linkText = "View all",
  size = Tag,
  class: className = "",
} = Astro.props;

const sizes = {
  h1: "text-4xl md:text-5xl",
  h2: "text-3xl md:text-4xl",
  h3: "text-2xl",
};
---

<div
  class={`mb-8 flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between ${className}`}
>
  <div class="max-w-2xl">
    <Tag class={`font-bold tracking-tight text-brand-deep ${sizes[size]}`}>
      {title}
    </Tag>
    {subtitle && <p class="mt-2 text-base text-stone-600">{subtitle}</p>}
  </div>
  {href && (
    <a
      href={href}
      class="shrink-0 text-sm font-semibold text-brand underline decoration-brand-rule decoration-2 underline-offset-4 hover:decoration-brand"
    >
      {linkText}
    </a>
  )}
</div>
