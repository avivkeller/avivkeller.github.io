---
const {
  variant = "primary",
  size = "md",
  href,
  target = "_self",
  class: className = "",
  ...props
} = Astro.props;

const variants = {
  primary: "bg-brand text-white hover:bg-brand-deep",
  secondary:
    "border border-stone-900 text-stone-900 hover:border-brand hover:text-brand",
  ghost: "text-stone-700 hover:bg-brand-tint hover:text-brand",
};

const sizes = {
  sm: "h-9 px-3.5 text-sm",
  md: "h-10 px-4 text-sm",
  lg: "h-11 px-5 text-base",
};

const baseClasses =
  "inline-flex items-center justify-center gap-2 rounded-sm font-semibold whitespace-nowrap transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";
const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;

const Component = href ? "a" : "button";
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<Component class={classes} {...(href ? { href, target, rel } : {})} {...props}>
  <slot />
</Component>
