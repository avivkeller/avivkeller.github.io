---
const {
  variant = "primary",
  size = "md",
  href,
  target = "_self",
  class: className = "",
  ...props
} = Astro.props;

const variants = {
  primary:
    "bg-gradient-to-r from-red-600 to-red-700 text-white hover:from-red-700 hover:to-red-800 shadow-lg hover:shadow-xl",
  secondary:
    "bg-white text-gray-700 hover:text-red-600 shadow-md hover:shadow-lg border border-gray-200",
  outline:
    "border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white",
  ghost: "text-gray-600 hover:text-red-600 hover:bg-red-50",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
  xl: "px-10 py-5 text-xl",
};

const baseClasses =
  "inline-flex items-center justify-center font-semibold rounded-full transition-all duration-300 hover:scale-105";
const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;

const Component = href ? "a" : "button";
---

<Component class={classes} {...href ? { href, target } : {}} {...props}>
  <slot />
</Component>
